# Environment variables
.env

# Data cache (large, not committed)
data/daily/
data/intraday/
data/factors/
data/ref/
data/ml/
data/mining/
# Governed research corpora, immutable price snapshots, OOF predictions, and
# append-only trial ledgers are large local evidence. Compact reports and
# machine-readable invalidation records live under research/results instead.
data/research/mining_v4/
# Mining V5 compact manifests are tracked; large immutable daily snapshots are local.
data/research/mining_v5/**/daily/
# V6 PIT raw snapshots and prospective hash-chain ledger are local evidence.
# Schemas, compact inventories/readiness artifacts, and tests are tracked.
data/pit/
data/.yf_cache/
data/_catalog.parquet
data/baseline/
data/paper_runs/
data/trades_scanner_state*.json
# Options branch data — raw fetches + derived parquets (regenerable);
# summary JSONs stay tracked as audit trail.
data/options/snapshots/
data/options/backtest/
data/options/analysis/*.parquet
data/options/paper_runs/
data/*.db
data/*.db-shm
data/*.db-wal

# Reports output (not committed)
reports/

# Acceptance pack artifacts (M2); regenerable from mining archive
artifacts/

# Paper trading runtime state (PnL DB, alignment reports, checkpoints)
data/paper_trading/
# Phase 3 raw sealed batches, locks, and governance state are operational
# evidence and may contain unreleased rows; only fixed summaries are tracked.
data/sealed_evidence/
# Phase 3 append-only raw collection records (trusted and quarantine).
# Only schemas/config/docs are tracked; operational provider rows are not.
data/collection/

# Dev-process artifacts (baseline snapshots, coverage reports, etc.)
dev/artifacts/

# External LLM handoff seed dumps (M15); regenerable via
# scripts/dump_llm_handoff_context.py
docs/llm_handoff_seed_*.md

# S&P 500 ticker list snapshots (regenerable from Wikipedia via
# scripts/fetch_sp500_pool.py --save-list)
data/sp500_tickers_latest.txt
data/sp500_tickers_*.txt

# Runtime logs
logs/
nohup.out

# Jupyter
.ipynb_checkpoints/
research/**/*.ipynb
research/results/**/*.lock

